# Copy to .env and fill in. Keys are read only from the environment; config.yaml
# names the variable to use (llm.api_key_env) and never contains a key.

# OpenAI (the default: llm.api_key_env = OPENAI_API_KEY)
OPENAI_API_KEY=

# Gemini through its OpenAI-compatible endpoint. Use it with:
#   --set llm.api_key_env=GEMINI_API_KEY
#   --set llm.base_url=https://generativelanguage.googleapis.com/v1beta/openai/
# plus Gemini model names under `models:` (see README).
GEMINI_API_KEY=
