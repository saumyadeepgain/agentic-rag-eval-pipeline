# ─── Required ────────────────────────────────────────────────────────────────
# OpenAI API key — used for LLM (GPT-4o / GPT-4o-mini) and embeddings
OPENAI_API_KEY=sk-...

# ─── Optional ────────────────────────────────────────────────────────────────
# Cohere API key — only needed if using Cohere Rerank instead of local reranker
COHERE_API_KEY=

# LangSmith tracing (optional observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-rag

# ─── Model Overrides (defaults shown) ────────────────────────────────────────
# Generator model (used for answer synthesis)
GENERATOR_MODEL=gpt-4o

# Grader/router model (cheap fast model for classification tasks)
GRADER_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# ─── ChromaDB ────────────────────────────────────────────────────────────────
# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./data/chroma_db
